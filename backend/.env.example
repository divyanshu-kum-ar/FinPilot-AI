# Backend Environment Variables — copy to .env and fill in values
# NEVER commit the actual .env file

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas — get from Atlas dashboard > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Firebase Admin SDK — paste the full JSON string from your Firebase service account key
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Google Gemini AI — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — set to your Render frontend URL after deployment
FRONTEND_URL=https://your-frontend-name.onrender.com
