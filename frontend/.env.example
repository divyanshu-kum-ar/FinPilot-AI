# Frontend Environment Variables — copy to .env and fill in values
# NEVER commit the actual .env file
# All variables MUST start with VITE_ to be accessible in the browser

# Backend API URL
# Development:   http://localhost:5000
# Production:    https://your-backend-name.onrender.com
VITE_API_URL=http://localhost:5000

# Firebase — get from Firebase Console > Project Settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
